{
  "name": "preventicus",
  "displayName": "pcoreEditor",
  "description": "A editor to open, manipulate and save pcore files",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:pcoreEditor.openPcoreFile",
    "onCommand:pcoreEditor.doSomethingWithOpenFile",
    "onCommand:pcoreEditor.contextOpenPcore",
    "onCustomEditor:pcoreEditor.editor",
    "workspaceContains:**/*.pcore",
    "onView:pcoreExplorer"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "preventicus.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "pcoreEditor.openPcoreFile",
        "title": "Open PCore File"
      },
      {
        "command": "pcoreEditor.doSomethingWithOpenFile",
        "title": "Do Something with PCore File",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "pcoreEditor.contextOpenPcore",
        "title": "Open with PCore Editor (Context Menu)"
      }
    ],
    "customEditors": [
      {
        "viewType": "pcoreEditor.editor",
        "displayName": "PCore Editor",
        "selector": [
          {
            "filenamePattern": "*.pcore"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pcoreEditor.contextOpenPcore",
          "group": "navigation",
          "when": "resourceExtname == .pcore"
        }
      ],
      "editor/title": [
        {
          "command": "pcoreEditor.doSomethingWithOpenFile",
          "group": "navigation",
          "when": "resourceExtname == .pcore"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pcore-view-container",
          "title": "PCore Explorer",
          "icon": "$(heart)"
        }
      ]
    },
    "views": {
      "pcore-view-container": [
        {
          "id": "pcoreExplorer",
          "name": "PCore Files"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pcoreExplorer",
        "contents": "Willkommen im PCore Editor!\n\n[Öffne eine PCore-Datei](command:pcoreEditor.openPcoreFile)\n\n[Mehr über PCore](command:pcoreEditor.showWelcomeWebview)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.29.0",
    "minimatch": "^10.0.3",
    "npm-run-all": "^4.1.5",
    "typescript": "5.8",
    "typescript-eslint": "^8.34.1"
  },
  "dependencies": {
    "glob": "^11.0.3",
    "rimraf": "^6.0.1",
    "@preventicus/pcore": "git+https://github.com/preventicus/pcore_ts.git#FOR-888_4"
  }
}
